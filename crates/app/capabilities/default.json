{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte des Hauptfensters",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "mailto:*"
        },
        {
          "url": "https://github.com/Zer0SkiLL/b-cker-verwaltung*"
        }
      ]
    },
    "clipboard-manager:allow-write-text",
    "updater:default",
    "process:allow-restart"
  ]
}
