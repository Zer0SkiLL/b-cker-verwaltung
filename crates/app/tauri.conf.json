{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mitgliederverwaltung",
  "version": "0.1.0",
  "identifier": "ch.baeckervereinigung.mitgliederverwaltung",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../../ui" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../../ui" }
  },
  "app": {
    "windows": [
      {
        "title": "Mitgliederverwaltung",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
